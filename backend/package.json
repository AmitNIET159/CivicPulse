{
  "name": "civicpulse-backend",
  "version": "1.0.0",
  "description": "CivicPulse Backend API — Civic Issue Reporting Platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
